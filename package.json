{
  "name": "dsh-glm-quota-dock",
  "version": "1.0.0",
  "type": "module",
  "description": "Shows GLM Coding Plan quota usage next to the session stats row.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Everglow28/dsh-glm-quota-dock.git"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
